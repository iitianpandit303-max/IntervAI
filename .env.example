VITE_API_BASE_URL=http://127.0.0.1:8000

# Any OpenAI-compatible chat-completions provider can be used.
# Leave these blank and IntervAI will safely use deterministic fallback mode.
INTERVAI_LLM_BASE_URL=
INTERVAI_LLM_API_KEY=
INTERVAI_LLM_MODEL=
INTERVAI_LLM_TIMEOUT_SECONDS=20
INTERVAI_LLM_MAX_RETRIES=1

# Optional SQLite path. Point this at a persistent disk when the host provides one.
INTERVAI_SESSION_DB_PATH=

# Comma-separated browser origins allowed to call the FastAPI backend.
INTERVAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
